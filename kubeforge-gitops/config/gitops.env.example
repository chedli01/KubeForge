# Existing local Kubernetes context.
KUBE_CONTEXT=kind-kubeforge

# Tested against the official Argo CD v3.5.4 installation manifest.
ARGOCD_VERSION=v3.5.4

# Replace with your GitHub HTTPS URL before creating the Application.
GIT_REPO_URL=https://github.com/YOUR_USER/YOUR_REPOSITORY.git
GIT_REVISION=main

# If this folder lives inside the Git repository root:
GIT_PATH=kubeforge-gitops/environments
# If this folder itself is your Git repository root, instead use:
# GIT_PATH=environments

APP_NAME=kubeforge-environments
TEST_ENV=gitops-demo
